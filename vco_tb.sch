C {vdd.sym} -290 -250 0 0 {name=l1 lab=VDD}
C {gnd.sym} -290 -60 0 0 {name=l2 lab=0}
C {vsource.sym} 650 80 0 0 {name=V1 value=1.8 savecurrent=false}
C {gnd.sym} 650 130 0 0 {name=l11 lab=0}
C {vdd.sym} 650 30 0 0 {name=l12 lab=VDD}
C {code_shown.sym} -330 190 0 0 {name=sim_commands
value="
.lib /foss/pdks/sky130A/libs.tech/ngspice/sky130.lib.spice tt
.ic v(OUT)=0
.control
	let vstart = 1.0
	let vstop = 1.8
	let vstep = 0.1

	let vact = vstart
	let count = 9

	let const.freq_vec = unitvec(count)
	let const.vctrl_vec = unitvec(count)
	let idx = 0

	while vact <= vstop + 0.01
		alter Vctrl = vact
		tran 10p 300n uic
		meas tran p TRIG v(out) val=0.9 RISE=2 TARG v(out) val=0.9 RISE=3

		let f = 1 / p
		let const.freq_vec[idx] = f
		let const.vctrl_vec[idx] = vact

		let vact = vact + vstep
		let idx = idx + 1
	endwhile
	setplot const
	plot freq_vec vs vctrl_vec title 'VCO Tuning Curve (F vs Vctrl)'
.endc
"}
